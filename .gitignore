# Testing projects track their code and parameters, not their data (27 MB,
# redistribution terms unchecked) or outputs. The .gitkeeps keep data/,
# inputs/ and outputs/ on a fresh clone, so the README has somewhere to point.
test_projects/*/data/*
!test_projects/*/data/.gitkeep
test_projects/*/inputs/allometry/
test_projects/*/outputs/*
!test_projects/*/outputs/.gitkeep

# Example projects track everything they are run from -- code, data and
# inputs -- so they run straight after a clone. Only what a run writes is
# ignored.
example_projects/*/outputs/*
!example_projects/*/outputs/.gitkeep

# Jupyter stuff
.jupyter_ystore.db
.virtual_documents
.jupyter
# OS cruft
.DS_Store
__pycache__/
*.pyc

# Generated project data -- regenerable from gpkg + config.toml, don't track
projects/*/raw_data/
projects/*/inputs/allometry/
projects/*/inputs/stand_data.json
projects/*/outputs/
example_projects/*/inputs/allometry/
example_projects/*/inputs/stand_data.json
example_projects/*/outputs/
